  "cards": [
    {
      "dot": "cyan",
      "title": "Request path",
      "items": [
        "admin/* routes \u00e2\u2020\u2019 application/controllers/admin + module controllers (MX loader)",
        "Modules self-register menus, permissions and invoice hooks at admin_init",
        "Tables post AJAX to controller endpoints, e.g. fleet/logbook_table"
      ]
    },
    {
      "dot": "emerald",
      "title": "Custom modules",
      "items": [
        "fleet is the largest custom module: bookings, vehicles, drivers, logbooks",
        "Also custom: accounts, hrm, salary, goals, surveys",
        "Each ships its own controllers/models/views/assets under modules/<name>/"
      ]
    },
    {
      "dot": "violet",
      "title": "Persistence & state",
      "items": [
        "MariaDB mnritsol_fms on localhost via mysqli, utf8mb4",
        "Sessions stored in the database (SESS_DRIVER=database); CSRF on",
        "Files land on local disk: uploads/, media/, module upload folders"
      ]
    },
    {
      "dot": "amber",
      "title": "Async & mail",
      "items": [
        "Cron.php is key-gated and throttled ~5 min, then cron_model runs scheduled work",
        "pipe.php feeds inbound ticket mail; Check_emails polls IMAP",
        "fleet hooks after_cron_run to schedule vehicle inspections"
      ]
    },
    {
      "dot": "rose",
      "title": "Deployment",
      "items": [
        "Prod: shared host fms.mnr-itsolutions.com (LiteSpeed lsapi, cPanel)",
        "Local: docker-compose Apache + PHP 8.3 on :8090, MariaDB 10.6 on :3307",
        "Code deployed to the host by SFTP copy, not by pipeline"
      ]
    }
  ]
}