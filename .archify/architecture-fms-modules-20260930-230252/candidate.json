  "cards": [
    {
      "dot": "cyan",
      "title": "How modules attach",
      "items": [
        "Each module ships modules/<name>/<name>.php that registers hooks at admin_init",
        "Hooks wire menus, staff permissions, head/footer assets and cron callbacks",
        "MX loader routes admin/<module>/<method> to the module's controllers"
      ]
    },
    {
      "dot": "emerald",
      "title": "Cross-module calls",
      "items": [
        "fleet adjust_cash loads salary/salary_model to post driver advances",
        "accounts resolves cash-out from fleet_logbooks rows (hand/total/paid cash)",
        "hrm loads goals/goals_model inside its model layer"
      ]
    },
    {
      "dot": "violet",
      "title": "Core event listeners",
      "items": [
        "accounts subscribes to after_payment_added/updated/deleted + expense events",
        "fleet filters invoice PDF/HTML renderers for drivers, importer, exporter",
        "goals and surveys join global search and dashboard widgets"
      ]
    },
    {
      "dot": "amber",
      "title": "Cron participation",
      "items": [
        "backup, fleet, goals and surveys register after_cron_run work",
        "fleet uses it for vehicle inspection schedules; backup for DB dumps"
      ]
    },
    {
      "dot": "rose",
      "title": "Isolation reality",
      "items": [
        "All modules run in one PHP process and share the request lifecycle",
        "One MariaDB holds every module's tables — no per-module schemas",
        "A module bug or hook misfire can break unrelated admin pages"
      ]
    }
  ]
